# Server
PORT=3000
NODE_ENV=production

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Cache Control
CACHE_ENABLED=true
CACHE_MIN_CHARS=1000
CACHE_MAX_BREAKPOINTS=4
CACHE_TTL=5m
# Comma-separated model prefixes that support cache_control. Use * for all models.
CACHE_MODEL_PREFIXES=anthropic/,deepseek/,google/,openai/,x-ai/

# Logging
LOG_LEVEL=info
