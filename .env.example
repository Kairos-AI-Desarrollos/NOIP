# Server
PORT=3000
NODE_ENV=production

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Authentication — generate a token with: npx ts-node scripts/generate-token.ts
JWT_SECRET=your-secure-secret-here

# Cache Control (Claude-specific parameters)
CACHE_ENABLED=true
CACHE_MIN_CHARS=1000
CACHE_MAX_BREAKPOINTS=4
CACHE_TTL=1h

# Logging
LOG_LEVEL=info
